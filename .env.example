# Server only (Vercel env). Never commit real values.
GEMINI_API_KEY=            # GCP savorlm-app key "savorlm-gemini", restricted to generativelanguage
EXA_API_KEY=
TYPESAFE_API_KEY=
GOOGLE_PLACES_KEY=         # GCP key "savorlm-places-server", restricted to places + geocoding-backend
FIREBASE_SERVICE_ACCOUNT_B64= # base64 of savorlm-server@savorlm-app service account JSON (datastore.user); cache, budgets, shared lists

# Public (browser). Maps JavaScript API only; restricted by HTTP referrer to savorlm.com, *.vercel.app, localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# PostHog (project "SavorLM", id 716413, US Cloud). Public write-only token.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# Optional
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_EAR_MODEL=gemini-3.5-flash-lite      # voice transcription
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite     # venue extraction
# GEMINI_PICK_MODEL=gemini-3.5-flash-lite     # ranking + spoken intros (3.8 Flash was ~7 s vs ~4 s)
# GEMINI_THINKING=low
# SAVVY_VOICE=Sadachbia
# BUDGET_GUIDE_DAILY=1500  BUDGET_TTS_DAILY=8000  BUDGET_HEAR_DAILY=2000  BUDGET_PHOTO_DAILY=4000
