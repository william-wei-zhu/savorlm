# Server only (Vercel env). Never commit real values.
GEMINI_API_KEY=            # GCP savorlm-app key "savorlm-gemini", restricted to generativelanguage
EXA_API_KEY=
TYPESAFE_API_KEY=
GOOGLE_PLACES_KEY=         # GCP key "savorlm-places-server", restricted to places.googleapis.com
FIREBASE_SERVICE_ACCOUNT_B64= # base64 of savorlm-server@savorlm-app service account JSON (datastore.user)

# Public (browser). Restricted by HTTP referrer to savorlm.com, *.vercel.app, localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_EAR_MODEL=gemini-3.5-flash-lite
# SAVVY_VOICE=Sadachbia
